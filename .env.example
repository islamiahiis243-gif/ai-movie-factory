# ==============================================================================
# AI MOVIE FACTORY — PRODUCTION ENVIRONMENT VARIABLES (.env.example)
# Reference: SSOT Part 8 (Sec 20), Part 11 (Sec 28, 29, 30), Part 15 (Sec 45)
# ==============================================================================

# 1. PUBLIC CLIENT VARIABLES (Safe for Vite Browser Bundle & Vercel Client Build)
# Copy from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Canonical public application URL (Vercel production domain or local dev URL)
APP_URL="https://ai-movie-factory.vercel.app"

# 2. SERVER-ONLY VARIABLES (Strictly for Vercel Serverless API / Backend Workers)
# NEVER prefix these with VITE_ and NEVER expose them to the browser!
SUPABASE_SECRET_KEY="your-supabase-service-role-secret-key"
GEMINI_API_KEY="your-google-gemini-api-key"

# 3. PAYMENT GATEWAY WEBHOOK SECRETS (Server-Only for /api/payment-webhook)
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 4. SERVERLESS CRON & WORKER AUTHENTICATION (Server-Only)
# Passed in Authorization: Bearer <secret> by Vercel Cron or manual admin trigger
CRON_SECRET="your-32-byte-secure-cron-secret-token"

# 5. OAUTH BROKER & ENCRYPTED TOKEN VAULT (Server-Only for AES-256-GCM)
# 32-byte hex string (64 characters) or base64 string
OAUTH_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
# Secret for HMAC state token generation
OAUTH_STATE_SECRET="your-super-secret-oauth-state-signing-key"

# 6. PLATFORM OAUTH PROVIDER CREDENTIALS (Server-Only for T9.3/T9.4/T9.5)
# YouTube / Google Cloud OAuth 2.0 Credentials
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-google-client-secret"

# TikTok for Developers Credentials
TIKTOK_CLIENT_KEY="your-tiktok-client-key"
TIKTOK_CLIENT_SECRET="your-tiktok-client-secret"

# Meta (Instagram & Facebook) App Credentials
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"
